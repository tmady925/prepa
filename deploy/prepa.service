[Unit]
Description=Prepa — WhatsApp AI Tutor
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=prepa
Group=prepa
WorkingDirectory=/home/prepa/app

# Charge les variables d'environnement depuis .env
EnvironmentFile=/home/prepa/app/.env

ExecStart=/home/prepa/app/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --timeout-keep-alive 300 \
    --timeout-graceful-shutdown 30 \
    --log-level info \
    --access-log

Restart=always
RestartSec=5

# Logs systemd
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prepa

# Sécurité
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
